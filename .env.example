# ─── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API with credentials.
#
# In development both clients reach the API through their own Vite proxy, so
# only the desktop client's origin needs listing here — the mobile proxy strips
# the Origin header (see mobile/vite.config.js) precisely so that a phone on the
# LAN, whose origin is an unpredictable IP, does not need an entry.
#
# In production, list every origin a client is actually served from. Nothing is
# needed here when both builds are served from the API's own domain.
CORS_ORIGIN=http://localhost:5173

# ─── Database (MySQL 8) ──────────────────────────────────────────────────
# Either set DATABASE_URL, or the individual DB_* values below.
DATABASE_URL=mysql://fittrack:fittrack@localhost:3306/fittrack
DB_HOST=localhost
DB_PORT=3306
DB_USER=fittrack
DB_PASSWORD=fittrack
DB_NAME=fittrack
DB_CONNECTION_LIMIT=10
# Managed providers (PlanetScale, Aiven, RDS) require TLS: set to "true".
DB_SSL=false

# Used by docker-compose for the local dev database.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=fittrack
MYSQL_USER=fittrack
MYSQL_PASSWORD=fittrack
MYSQL_PORT=3306

# ─── Auth ────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Set to true when the API is served over HTTPS (required for cross-site cookies).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ─── USDA FoodData Central ───────────────────────────────────────────────
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
# Without a key the API falls back to the locally seeded USDA food table.
USDA_API_KEY=
USDA_API_BASE=https://api.nal.usda.gov/fdc/v1

# ─── Clients (Vite) ──────────────────────────────────────────────────────
# Shared by both the desktop client (port 5173) and the mobile one (5174).
#
# Leave empty to call the API at /api on the same origin (the dev proxy in
# development, the same domain in production).
VITE_API_URL=

# Where both dev servers proxy /api to. Must match the API's PORT above.
# Named separately from PORT on purpose: launchers set PORT to the dev
# server's own port, which would make the proxy point at itself.
VITE_DEV_API_TARGET=http://127.0.0.1:4000
